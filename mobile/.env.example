# Base URL of the Fiscalize backend (the `backend/` submodule, port 3000 by default).
#
# Leave this unset to fall back to the per-platform default in
# src/services/api-client.ts:
#   Android emulator -> http://10.0.2.2:3000
#   iOS simulator    -> http://localhost:3000
#
# A physical device cannot reach either, and needs this machine's LAN IP —
# find it with `ipconfig getifaddr en0`:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3000
#
# The EXPO_PUBLIC_ prefix bundles the value into the app, so never put a
# secret here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
