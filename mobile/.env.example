# Backend do Fiscalize.
#
# Padrão: o backend publicado no Render
# (https://fiscalize-backend.onrender.com), configurado em
# src/services/api-client.ts.
#
# Para rodar contra o backend local (submódulo `backend/`, porta 3000),
# descomente a linha correspondente ao seu ambiente:
#   Android emulator -> http://10.0.2.2:3000
#   iOS simulator    -> http://localhost:3000
#
# Um celular físico não alcança a máquina local sem o IP da rede — descubra
# com `ipconfig getifaddr en0`:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3000
#
# O prefixo EXPO_PUBLIC_ leva o valor para dentro do bundle do app, então
# nunca coloque um segredo aqui.
EXPO_PUBLIC_API_BASE_URL=https://fiscalize-backend.onrender.com
